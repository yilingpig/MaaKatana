{
  "interface_version": 2,
  "name": "MaaKatana",
  "description": "这是一个使用 MaaFramework 创建的个人用自动化工具，用于日本拼图nonogram katana的自动化。",
  "option": {
    "AllowColorNonogramPaintTest": {
      "type": "switch",
      "label": "允许彩色数织安全绘制",
      "description": "仅用于独立的彩色数织绘制测试，默认关闭。开启后会实际点击模拟器棋盘。",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "label": "允许",
          "pipeline_override": {
            "ColorNonogram1080pPaintTest": {
              "action": {
                "param": {
                  "custom_action_param": {
                    "allow_paint": true
                  }
                }
              }
            }
          }
        },
        {
          "name": "No",
          "label": "禁止",
          "pipeline_override": {
            "ColorNonogram1080pPaintTest": {
              "action": {
                "param": {
                  "custom_action_param": {
                    "allow_paint": false
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "contact": "请输入文本",
  "license": "MIT",
  "welcome": "首次使用！欢迎使用 MaaKatana!",
  "github": "https://github.com/yilingpig/MaaKatana",
  "version": "0.1.0",
  "controller": [
    {
      "name": "安卓端",
      "type": "Adb",
      "display_short_side": 720
    }
  ],
  "resource": [
    {
      "name": "default",
      "path": [
        "./resource"
      ]
    }
  ],
  "task": [
    {
      "name": "启动游戏",
      "entry": "启动游戏"
    },
    {
      "name": "观看广告",
      "entry": "进入公会"
    },
    {
      "name": "收集产物",
      "entry": "事务处"
    },
    {
      "name": "商队",
      "entry": "点击商队"
    },
    {
      "name": "汽船",
      "entry": "检查汽船"
    },
    {
      "name": "汽船-雷克雅未克",
      "entry": "检查汽船_雷克雅未克"
    },
    {
      "name": "汽船-墨西哥",
      "entry": "检查汽船_墨西哥"
    },
    {
      "name": "汽船-墨尔本",
      "entry": "检查汽船_墨尔本"
    },

    {
      "name": "彩色数织1080p安全绘制测试",
      "entry": "ColorNonogram1080pPaintTest",
      "option": [
        "AllowColorNonogramPaintTest"
      ]
    },
    {
      "name": "黑白数织测试",
      "entry": "黑白数织测试"
    },
    {
      "name": "商店购买",
      "entry": "商店购买"
    },
    {
      "name": "交易所交换",
      "entry": "进入交易所交换"
    }
  ],
  "agent": {
    "child_exec": "python",
    "child_args": [
      "./agent/main.py"
    ]
  }
}
